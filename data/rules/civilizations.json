 "_comment": "Sovereign's launch roster (specs/sovereign/leaders-and-art-style.md, Launch roster). Hand-written. Each leader's agenda (what the AI likes and dislikes) is scored in core/src/diplomacy.cpp. Unique units (units, abilities) are rows built on a `base` unit: only what differs is written, the rest comes from the generated Civ data; `uniqueTo` locks them to the civ and they replace their base for it (leaders-and-art-style: Civ abilities, uniques and dynasties). Unique buildings are rows built on a `base` building (whole `yields`, `greatWorkSlots` and `greatPersonPoints` objects are written out since an object replaces the base's); unique improvements are full rows. Unlocks the roster leaves open: Paradise Garden at Early Empire, Beacon Tower at Construction, Nilometer at Irrigation. Leader abilities (`leaderAbility`, Leader details) use the same typed fields as civ abilities. Movement on a kind of ground (the War Chariot on flat land, the Mandinka Lancer in desert, the Chasqui, the Royal Road and Earthshaker on roads) counts where the unit's turn starts, as the Heavy Chariot's does (05); the War Chariot keeps the Heavy Chariot's +1 on open ground. Not modelled yet: Qin's free roads (Builders do not lay roads), Augustus's and Cyrus's already-default parts (captured cities keep their buildings). Approximations: the Legionary one Builder charge for any improvement, the Repeating Crossbow may also move after attacking.",
 "civilizations": [
  {"id": "CIVILIZATION_ENGLAND", "name": "England", "leader": "LEADER_ELIZABETH_I", "agenda": "AGENDA_QUEEN_OF_THE_SEAS", "agendaName": "Queen of the Seas", "agendaText": "Likes civs that keep their fleets away from her coasts; dislikes civs with a navy larger than hers nearby.", "leaning": "Statesman", "voice": "Shrewd, witty and guarded; proud of her navy and her independence; speaks with regal poise and dry humour.", "cityNames": ["London", "York", "Nottingham", "Canterbury", "Bristol", "Norwich", "Winchester", "Exeter", "Lincoln", "Oxford", "Coventry", "Durham"], "ability": {"name": "Mills and Mines", "extraAdjacency": [{"district": "DISTRICT_INDUSTRIAL_ZONE", "from": "DISTRICT_HARBOR", "yield": "PRODUCTION", "amount": 1}]}, "leaderAbility": {"name": "Sea Dogs", "domainProductionPercent": {"SEA": 25}, "greatPersonPercent": {"GREAT_PERSON_CLASS_ADMIRAL": 50}, "intercontinentalRouteGold": 2}},
  {"id": "CIVILIZATION_FRANCE", "name": "France", "leader": "LEADER_CHARLEMAGNE", "agenda": "AGENDA_DEFENDER_OF_THE_FAITH", "agendaName": "Defender of the Faith", "agendaText": "Likes civs following his religion; dislikes civs converting his cities.", "leaning": "Warlord", "voice": "Pious, ambitious and commanding; sees himself as protector of the faith and of learning; speaks plainly, like a soldier-king.", "cityNames": ["Aachen", "Paris", "Reims", "Orleans", "Tours", "Lyon", "Metz", "Rouen", "Soissons", "Poitiers", "Toulouse", "Laon"], "ability": {"name": "Cathedral Builders", "wonderProductionPercent": 15, "wonderEras": [2, 3], "amenityPerWonder": 1}, "leaderAbility": {"name": "Carolingian Renaissance", "districtBuildingYields": [{"district": "DISTRICT_HOLY_SITE", "yields": {"SCIENCE": 1, "CULTURE": 1}}], "strengthNearLeader": [{"class": "HEAVY_CAVALRY", "amount": 3, "range": 2}]}},
  {"id": "CIVILIZATION_ROME", "name": "Rome", "leader": "LEADER_AUGUSTUS", "agenda": "AGENDA_PAX_ROMANA", "agendaName": "Pax Romana", "agendaText": "Likes civs at peace; dislikes warmongers.", "leaning": "Builder-King", "voice": "Calm, calculating and statesmanlike; prizes order, peace on his terms and grand works; speaks with measured authority.", "cityNames": ["Roma", "Ostia", "Antium", "Capua", "Neapolis", "Ravenna", "Mediolanum", "Arretium", "Brundisium", "Aquileia", "Verona", "Pompeii"], "ability": {"name": "Colonia", "foundPopulation": 1, "foundBuilding": "BUILDING_MONUMENT"}, "leaderAbility": {"name": "City of Marble", "cityCenterBuildingProductionPercent": 20, "wonderProductionPercent": 20, "wonderEras": [0, 99], "governorAmenity": 1}},
  {"id": "CIVILIZATION_GREECE", "name": "Greece", "leader": "LEADER_LEONIDAS_I", "agenda": "AGENDA_SPARTAN_PRIDE", "agendaName": "Spartan Pride", "agendaText": "Respects civs with strong armies; scorns civs with weak ones.", "leaning": "Warlord", "voice": "Blunt, laconic and fearless; respects strength and courage, scorns softness; uses few words.", "cityNames": ["Sparta", "Gytheio", "Amyclae", "Pellana", "Sellasia", "Messene", "Pylos", "Tegea", "Argos", "Corinth", "Megalopolis", "Kythira"], "ability": {"name": "Polis", "culturePerSuzerainty": 2, "extraAdjacency": [{"district": "DISTRICT_THEATER_SQUARE", "from": "DISTRICT_ENCAMPMENT", "yield": "CULTURE", "amount": 1}]}, "leaderAbility": {"name": "Hold the Pass", "grantAbilities": ["ABILITY_HOLD_THE_PASS"], "districtBuildingYields": [{"district": "DISTRICT_ENCAMPMENT", "yields": {"CULTURE": 1}}]}},
  {"id": "CIVILIZATION_PERSIA", "name": "Persia", "leader": "LEADER_CYRUS", "agenda": "AGENDA_TOLERANT_CONQUEROR", "agendaName": "Tolerant Conqueror", "agendaText": "Likes civs that spare the cities they take; hates civs that raze them.", "leaning": "Statesman", "voice": "Magnanimous, worldly and persuasive; respects other peoples and their customs; speaks generously but never forgets a slight.", "cityNames": ["Pasargadae", "Persepolis", "Susa", "Ecbatana", "Babylon", "Sardis", "Bactra", "Anshan", "Gordion", "Rhagae", "Arbela", "Tarsus"], "ability": {"name": "Satrapies", "governorLoyalty": 2, "governorGold": 2, "extraGovernorTitleCivic": "CIVIC_POLITICAL_PHILOSOPHY"}, "leaderAbility": {"name": "King of Kings", "capturedCityLoyalty": 5, "foreignReligionAmenity": 1, "grantAbilities": ["ABILITY_ROYAL_ROAD"]}},
  {"id": "CIVILIZATION_ARABIA", "name": "Arabia", "leader": "LEADER_SALADIN", "agenda": "AGENDA_MAGNANIMOUS", "agendaName": "Magnanimous", "agendaText": "Likes civs that wage war honourably and keep the peace; hates civs that send assassins.", "leaning": "Warlord", "voice": "Chivalrous, devout and honourable; keeps his word and expects others to keep theirs; speaks with courtesy and gravity.", "cityNames": ["Cairo", "Damascus", "Aleppo", "Jerusalem", "Mosul", "Alexandria", "Homs", "Hama", "Baalbek", "Karak", "Aswan", "Edessa"], "ability": {"name": "Caravan Cities", "desertRouteGold": 2, "extraAdjacency": [{"district": "DISTRICT_CAMPUS", "from": "DISTRICT_COMMERCIAL_HUB", "yield": "SCIENCE", "amount": 1}]}, "leaderAbility": {"name": "Chivalry of the Sultan", "strengthNearFollowingCity": {"amount": 4, "range": 2}, "districtBuildingYields": [{"district": "DISTRICT_HOLY_SITE", "yields": {"SCIENCE": 1}}]}},
  {"id": "CIVILIZATION_CHINA", "name": "China", "leader": "LEADER_QIN_SHI_HUANG", "agenda": "AGENDA_FIRST_EMPEROR", "agendaName": "First Emperor", "agendaText": "Dislikes civs that build wonders before him.", "leaning": "Builder-King", "voice": "Imperious, impatient and visionary; demands order and obedience; speaks as the first and only emperor.", "cityNames": ["Xianyang", "Handan", "Linzi", "Ying", "Daliang", "Ji", "Xinzheng", "Luoyang", "Chengdu", "Wu", "Panyu", "Yongcheng"], "ability": {"name": "Imperial Examinations", "capitalYieldsPerGovernorTitle": {"SCIENCE": 1, "CULTURE": 1}}, "leaderAbility": {"name": "Standardization", "extraBuilderCharges": 1, "wallProductionPercent": 50}},
  {"id": "CIVILIZATION_JAPAN", "name": "Japan", "leader": "LEADER_TOKUGAWA_IEYASU", "agenda": "AGENDA_CLOSED_COUNTRY", "agendaName": "Closed Country", "agendaText": "Dislikes civs that send missionaries or traders into his territory.", "leaning": "Statesman", "voice": "Patient, cautious and reserved; values peace, stability and keeping foreigners at a distance; speaks politely and sparingly.", "cityNames": ["Edo", "Kyoto", "Osaka", "Sunpu", "Nagoya", "Sendai", "Kanazawa", "Hiroshima", "Nagasaki", "Okayama", "Kagoshima", "Hamamatsu"], "ability": {"name": "Craft Guilds", "extraAdjacency": [{"district": "DISTRICT_INDUSTRIAL_ZONE", "from": "DISTRICT_THEATER_SQUARE", "yield": "PRODUCTION", "amount": 1}, {"district": "DISTRICT_THEATER_SQUARE", "from": "DISTRICT_INDUSTRIAL_ZONE", "yield": "CULTURE", "amount": 1}]}, "leaderAbility": {"name": "Edo Peace", "peaceYieldPercent": {"SCIENCE": 10, "CULTURE": 10}, "districtBuildingAmenities": [{"district": "DISTRICT_ENCAMPMENT", "amount": 1}]}},
  {"id": "CIVILIZATION_EGYPT", "name": "Egypt", "leader": "LEADER_RAMESSES_II", "agenda": "AGENDA_ETERNAL_NAME", "agendaName": "Eternal Name", "agendaText": "Dislikes civs with more wonders than he has.", "leaning": "Warlord", "voice": "Grandiose and proud; obsessed with monuments and a name that will last forever; speaks in lofty, boastful terms.", "cityNames": ["Pi-Ramesses", "Thebes", "Memphis", "Abydos", "Heliopolis", "Elephantine", "Bubastis", "Hermopolis", "Edfu", "Tanis", "Sais", "Akhetaten"], "ability": {"name": "Gift of the Nile"}, "leaderAbility": {"name": "Builder of Monuments", "wonderCulture": 2, "wonderProductionPercent": 15, "wonderEras": [0, 99], "grantAbilities": ["ABILITY_BUILDER_OF_MONUMENTS"]}},
  {"id": "CIVILIZATION_MALI", "name": "Mali", "leader": "LEADER_MANSA_MUSA", "agenda": "AGENDA_PATRON_OF_TRADE", "agendaName": "Patron of Trade", "agendaText": "Likes civs that send trade routes to him; dislikes civs that plunder traders.", "leaning": "Statesman", "voice": "Generous, wealthy and devout; loves trade and fair dealing; speaks warmly, often of gold and pilgrimage.", "cityNames": ["Niani", "Timbuktu", "Gao", "Djenne", "Walata", "Kangaba", "Taghaza", "Tadmekka", "Koumbi Saleh", "Kukiya", "Mema", "Takedda"], "ability": {"name": "Saharan Riches", "extraAdjacency": [{"district": "DISTRICT_COMMERCIAL_HUB", "fromTerrainBase": "DESERT", "per": 2, "yield": "GOLD", "amount": 1}]}, "leaderAbility": {"name": "Golden Pilgrimage", "internationalRouteYields": {"GOLD": 2, "FAITH": 1}, "faithPurchaseDistrict": "DISTRICT_COMMERCIAL_HUB"}},
  {"id": "CIVILIZATION_AZTEC", "name": "Aztec", "leader": "LEADER_MOCTEZUMA_I", "agenda": "AGENDA_HONOURABLE_WAR", "agendaName": "Honourable War", "agendaText": "Respects civs that declare war formally; hates surprise wars.", "leaning": "Warlord", "voice": "Fierce, devout and proud; honours open challenges and despises treachery; speaks with intensity.", "cityNames": ["Tenochtitlan", "Texcoco", "Tlacopan", "Tlatelolco", "Xochimilco", "Coyoacan", "Chalco", "Iztapalapa", "Azcapotzalco", "Tula", "Cuauhnahuac", "Tepeyac"], "ability": {"name": "Chinampas", "freshWaterFarmHousing": 0.5}, "leaderAbility": {"name": "Flower Wars", "killFaithPercent": 50, "capitalAmenityPerKills": 3, "capitalAmenityMax": 3}},
